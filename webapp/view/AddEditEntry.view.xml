<mvc:View controllerName="fi18n.form.controller.AddEditEntry"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns="sap.m" height="100%">

    <VBox id="_IDGenVBox5"></VBox>

    <Page id="addEditPage" title="{= ${form>/isCreateMode} ? 'Create New Record' : 'Person Details' }" showNavButton="true" navButtonPress=".onNavBack">

        <headerContent>
            <Button id="btnEdit" text="Edit" icon="sap-icon://edit" press=".handleEditPress" visible="{= !${form>/isCreateMode} &amp;&amp; !${form>/isEditMode} }" />
            <Button id="btnSave" text="Save" type="Emphasized" icon="sap-icon://save" press=".handleSavePress" visible="{form>/isEditMode}" />
            <Button id="btnCancel" text="Cancel" icon="sap-icon://decline" press=".handleCancelPress" visible="{form>/isEditMode}" />
        </headerContent>

        <content>
            <VBox id="_IDGenVBox" class="sapUiContentPadding">
                <form:SimpleForm id="_IDGenSimpleFormUnified" width="100%" layout="ResponsiveGridLayout" editable="{= ${form>/isCreateMode} || ${form>/isEditMode} }">
                <!-- columnsL="2" columnsM="2" labelSpanL="4" labelSpanM="4" emptySpanL="0" emptySpanM="0" breakpointL="1024" breakpointM="600"> -->
                    <form:content>
                    <core:Title id="_IDGenTitle1"/>
                        <Label id="_IDGenLabel" text="ID" visible="{= !${form>/isCreateMode} }" />
                        <Text id="_IDGenText18" text="{form>/SelectedRow/outId}" visible="{= !${form>/isCreateMode} }" />

                        <Label id="_IDGenLabel1" required="true" text="Name" />
                        <Input id="_IDGenInput5" value="{form>/SelectedRow/outName}" maxLength="15" editable="{= ${form>/isCreateMode} || ${form>/isEditMode} }" />

                        <Label id="_IDGenLabel2" text="Age"/>
                        <Input id="_IDGenInput6" value="{form>/SelectedRow/outAge}" maxLength="2" type="Number" editable="{= ${form>/isCreateMode} || ${form>/isEditMode} }" />

                        <Label id="_IDGenLabel3" text="Role"/>
                        <Input id="F-RoleAddEdit" value="{form>/SelectedRow/outRole}" showValueHelp="{= ${form>/isCreateMode} || ${form>/isEditMode} }" valueHelpRequest=".handleValueHelp" editable="{= ${form>/isCreateMode} || ${form>/isEditMode} }"/>

                        <Label id="_IDGenLabel4" text="Specify New Role" visible="{= ${form>/SelectedRow/outRole} === 'Others' }" />
                        <Input id="_IDGenInput7" value="{form>/SelectedRow/outRoleCustom}" visible="{= ${form>/SelectedRow/outRole} === 'Others' }" editable="{= ${form>/isCreateMode} || ${form>/isEditMode} }"/>

                        <Label id="_IDGenLabel5" text="Result"/>
                        <Select id="_IDGenSelect" selectedKey="{form>/SelectedRow/outResult}" enabled="{= ${form>/isCreateMode} || ${form>/isEditMode} }">
                            <core:Item id="_IDGenItem2" key="Pass" text="Pass" />
                            <core:Item id="_IDGenItem3" key="Fail" text="Fail" />
                        </Select>

                        <core:Title id="_IDGenTitle2"/>

                        <Label id="_IDGenLabel6" required="true" text="Email"/>
                        <Input id="_IDGenInput8" value="{form>/SelectedRow/outEmail}" maxLength="30" type="Email" editable="{= ${form>/isCreateMode} || ${form>/isEditMode} }"/>

                        <Label id="_IDGenLabel7" text="Address"/>
                        <VBox id="_IDGenVBox1">
                            <VBox id="_IDGenVBox3" items="{form>/SelectedRow/inaddresses}">
                                <items>
                                    <HBox id="_IDGenHBox" alignItems="Center" class="sapUiTinyMarginBottom">
                                        <TextArea id="_IDGenTextArea" value="{form>value}" rows="2" width="300px" editable="{= ${form>/isCreateMode} || ${form>/isEditMode} }" />
                                        <Button id="_IDGenButton" icon="sap-icon://delete" press=".onRemoveAddress" visible="{= ${form>/isCreateMode} || ${form>/isEditMode} }" class="sapUiTinyMarginBegin"/>
                                    </HBox>
                                </items>
                            </VBox>
                            <Button id="_IDGenButton1" icon="sap-icon://add" press=".onAddAddress" visible="{= ${form>/isCreateMode} || ${form>/isEditMode} }"/>
                        </VBox>

                        <Label id="_IDGenLabel8" text="Date of Birth"/>
                        <DatePicker id="_IDGenDatePicker" value="{path: 'form>/SelectedRow/outDob', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd-MMM-yyyy', UTC: true}}" displayFormat="dd-MMM-yyyy" valueFormat="dd-MMM-yyyy" editable="{= ${form>/isCreateMode} || ${form>/isEditMode} }" />

                        <Label id="_IDGenLabel9" text="Date and Time of Submission"/>
                        <DateTimePicker id="_IDGenDateTimePicker1" value="{path: 'form>/SelectedRow/outDos', type: 'sap.ui.model.type.DateTime', formatOptions: {pattern: 'dd/MM/yyyy HH:mm:ss', UTC: true}}" displayFormat="dd/MM/yyyy HH:mm:ss" valueFormat="dd/MM/yyyy HH:mm:ss" editable="{= ${form>/isCreateMode} || ${form>/isEditMode} }" />

                        <Label id="_IDGenLabel10" visible="{form>/isCreateMode}" />
                        <Button id="_IDGenButton2" text="Submit" type="Emphasized" press=".onSubmitEntry" visible="{form>/isCreateMode}" width="150px"/>
                    </form:content>
                </form:SimpleForm>
            </VBox>
        </content>
    </Page>
</mvc:View>