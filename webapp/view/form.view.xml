<mvc:View controllerName="fi18n.form.controller.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m" height="100%"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:svm="sap.ui.comp.smartvariants" core:require="{formatter: 'fi18n/form/model/formatter'}">

    <VBox id="_IDGenVBox4"></VBox>
    
    <f:DynamicPage id="page1">
        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle1">
                <f:heading>
                    <Title id="_IDGenTitle" text="Form With Table - JSON model" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader">
                <f:content>
                    <fb:FilterBar id="filterbar" persistencyKey="myPersKey" search=".onSearchTop" useToolbar="false" showClearOnFB="true">
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem" name="Result" label="Result" groupName="FormGroup" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox id="searchResult">
                                        <core:Item id="_IDGenItem" key="Pass" text="Pass"/>
                                        <core:Item id="_IDGenItem1" key="Fail" text="Fail"/>
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem id="_IDGenFilterGroupItem1" name="ID" label="ID" groupName="FormGroup" visibleInFilterBar="true">
                                <fb:control>
                                    <Input id="_IDGenInput" value="{form>/inIdS}" type="Number" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem2" name="Name" label="Name" groupName="FormGroup" visibleInFilterBar="true" visible="false">
                                <fb:control>
                                    <Input id="_IDGenInput1" value="{form>/inNameS}" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem3" name="Age" label="Age" groupName="FormGroup" visibleInFilterBar="true" visible="false">
                                <fb:control>
                                    <Input id="_IDGenInput2" value="{form>/inAgeS}" type="Number" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem4" name="Role" label="Role" groupName="FormGroup" visibleInFilterBar="true" visible="false">
                                <fb:control>
                                    <Input id="_IDGenInput3" value="{form>/inRoleS}" showValueHelp="true" valueHelpRequest=".handleValueHelp" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem5" name="Email" label="Email" groupName="FormGroup" visibleInFilterBar="true">
                                <fb:control>
                                    <Input id="_IDGenInput4" value="{form>/inEmailS}" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem6" name="Address" label="Address" groupName="FormGroup" visibleInFilterBar="true" visible="false">
                                <fb:control>
                                    <Input id="_IDGenInput9" value="{form>/inAdressS}" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem7" name="Date of Birth" label="Date of Birth" groupName="FormGroup" visibleInFilterBar="true" visible="false">
                                <fb:control>
                                    <DatePicker id="_IDGenDatePicker_DobS" value="{path: 'form>/inDobS', type: 'sap.ui.model.type.Date'}" displayFormat="dd-MMM-yyyy" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem id="_IDGenFilterGroupItem8" name="Date of Submission" label="Date of Submission" groupName="FormGroup" visibleInFilterBar="true" visible="false">
                                <fb:control>
                                    <DateTimePicker id="_IDGenDatePicker_DosS" value="{path: 'form>/inDosS', type: 'sap.ui.model.type.DateTime'}" displayFormat="dd/MM/yyyy HH:mm:ss" />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox id="_IDGenVBox2" class="sapUiContentPadding">
                <Toolbar id="_IDGenToolbar">
                    <SearchField id="_IDGenSearchField" search=".onSearch" width="auto" />
                    <Text id="_IDGenText" text="{form>/searchText}" />
                    <ToolbarSpacer id="_IDGenToolbarSpacer" />
                    <Button id="_IDGenButton3" icon="sap-icon://sorting-ranking" tooltip="Sorting Dialog Box" press=".handleOpenDialog"/>
                    <Button id="idAddEntryBtn" icon="sap-icon://add" text="Add New Entry" type="Emphasized" press=".onAddNavPress"/>
                </Toolbar>

                <Table items="{form>/Table}" id="dataTable" itemPress=".onRowPress">
                    <columns>
                        <Column id="_IDGenColumn">
                            <Text id="_IDGenText1" text="Result" />
                        </Column>
                        <Column id="_IDGenColumn1">
                            <Text id="_IDGenText2" text="ID" />
                        </Column>
                        <Column id="_IDGenColumn2">
                            <Text id="_IDGenText3" text="Name" />
                        </Column>
                        <Column id="_IDGenColumn3" visible="false">
                            <Text id="_IDGenText4" text="Age" />
                        </Column>
                        <Column id="_IDGenColumn4" visible="false">
                            <Text id="_IDGenText5" text="Role" />
                        </Column>
                        <Column id="_IDGenColumn5">
                            <Text id="_IDGenText6" text="Email" />
                        </Column>
                        <Column id="_IDGenColumn6" visible="false">
                            <Text id="_IDGenText7" text="Address" />
                        </Column>
                        <Column id="_IDGenColumn7" visible="false">
                            <Text id="_IDGenText15" text="Date of Birth" />
                        </Column>
                        <Column id="_IDGenColumn8" visible="false">
                            <Text id="_IDGenText16" text="Date and Time of Submission" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem" type="Active">
                            <cells>
                                <core:Icon id="_IDGenIcon" src="{= ${form>outResult} === 'Pass' ? 'sap-icon://accept' : 'sap-icon://decline'}" color="{= ${form>outResult} === 'Pass' ? 'Positive' : 'Negative'}"/>
                                <Text id="_IDGenText8" text="{form>outId}" />
                                <Text id="_IDGenText9" text="{form>outName}" />
                                <Text id="_IDGenText10" text="{form>outAge}" />
                                <Text id="_IDGenText11" text="{form>outRole}" />
                                <Text id="_IDGenText12" text="{form>outEmail}" />
                                <Text id="_IDGenText13" text="{form>outAddress}" wrapping="true" />
                                <Text id="_IDGenText14" text="{path: 'form>outDob', formatter: 'formatter.formatDate'}" />
                                <Text id="_IDGenText17" text="{path: 'form>outDos', formatter: 'formatter.formatDateTime'}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>